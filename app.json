{
  "expo": {
    "name": "SunCollection",
    "slug": "suncollection",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suncollection",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d7ee2"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "backgroundColor": "#1d7ee2",
      "barStyle": "light-content"
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sunapp.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/favicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1d7ee2",
          "dark": {
            "backgroundColor": "#1d7ee2"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to photos to upload expense receipts.",
          "cameraPermission": "The app needs access to camera to take photos of expense receipts.",
          "colors": {
            "cropToolbarColor": "#1d7ee2",
            "cropToolbarIconColor": "#ffffff",
            "cropToolbarActionTextColor": "#ffffff",
            "cropBackButtonIconColor": "#ffffff",
            "cropBackgroundColor": "#ffffff"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#1d7ee2",
              "cropToolbarIconColor": "#ffffff",
              "cropToolbarActionTextColor": "#ffffff",
              "cropBackButtonIconColor": "#ffffff",
              "cropBackgroundColor": "#ffffff"
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1d7ee2",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SunCollection to use your location when recording collections, loan details, and upfront cash entries.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
